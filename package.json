{
  "name": "hotnotclub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "mobile": "cd mobile && npm start",
    "backend": "cd backend && npm run dev",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "backend:build": "cd backend && npm run build",
    "setup": "npm install && cd mobile && npm install && cd ../backend && npm install && cd ../shared && npm install"
  },
  "description": "HOTNOTCLUB - Weekly photo competition app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Satoshiball/Amp"
  }
}
